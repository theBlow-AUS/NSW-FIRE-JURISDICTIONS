<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>au.nswfirecoverage.standalone</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Application Support/NSW Fire Coverage/bin/start-server.sh</string>
  </array>
  <key>UserName</key>
  <string>_nswfirecoverage</string>
  <key>GroupName</key>
  <string>_nswfirecoverage</string>
  <key>WorkingDirectory</key>
  <string>/Library/Application Support/NSW Fire Coverage</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ExitTimeOut</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Umask</key>
  <integer>23</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Library/Application Support/NSW Fire Coverage Data/logs/service.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Application Support/NSW Fire Coverage Data/logs/service-error.log</string>
</dict>
</plist>
